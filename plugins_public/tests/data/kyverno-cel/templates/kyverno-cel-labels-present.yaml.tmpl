# Generated by C2P ({{ engine }}) — rule {{ rule.id }} / check {{ check.id }}
# {{ check.description }}
apiVersion: policies.kyverno.io/v1
kind: ValidatingPolicy
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/rule-id: {{ rule.id }}
spec:
  variables:
    - name: required
      expression: '{{ params.required_labels.split(' ') | tojson }}'
    - name: owner
      expression: {{ params.owner | quote }}
