    },
    "components": [
      {
        "uuid": "33c13417-4701-4bfc-bffa-3b01a111dd62",
        "type": "service",
        "title": "container-supply-chain",
        "description": "Container image supply chain for the storefront stack: build provenance cosign signature verification and the cluster-held approved-registry ledger",
        "props": [
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "image-signature-verified",
            "remarks": "rule_set_00"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "Every container image admitted into the storefront namespace carries a valid Sigstore/cosign signature made either by the approved release identity or by the organization's own signing key; verification happens at admission against the registry and (for the release identity) the Rekor transparency log. CM-14 Signed Components is the narrative control but is selected by no 800-53 rev5 baseline so SI-7(15) Code Authentication carries the mapping",
            "remarks": "rule_set_00"
          },
          {
            "name": "Parameter_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "approved_signer_identity",
            "remarks": "rule_set_00"
          },
          {
            "name": "Parameter_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "OIDC subject of the release workflow permitted to sign storefront images (Sigstore keyless)",
            "remarks": "rule_set_00"
          },
          {
            "name": "Parameter_Id_2",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "approved_signer_oidc_issuer",
            "remarks": "rule_set_00"
          },
          {
            "name": "Parameter_Description_2",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "OIDC issuer that must have asserted the signing identity. Paired with approved_signer_identity: a subject is only meaningful against the issuer that vouched for it, so both are authored here rather than one being fixed in the template",
            "remarks": "rule_set_00"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "image-registry-approved",
            "remarks": "rule_set_01"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "Every container image is pulled from a registry that has an entry in the cluster-held approved-registry ledger (one ConfigMap per registry labelled supply-chain.example.com/ledger=approved-registry). The allow-list is cluster state and changes without redeploying policy",
            "remarks": "rule_set_01"
          },
          {
            "name": "Parameter_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "approved_registry_ledger_namespace",
            "remarks": "rule_set_01"
          },
          {
            "name": "Parameter_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "Namespace holding the approved-registry ledger ConfigMaps that the engine reads at evaluation time",
            "remarks": "rule_set_01"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "image-pinned-by-digest",
            "remarks": "rule_set_02"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "Every container image is referenced by immutable digest and never by a mutable tag such as latest so that the deployed baseline configuration is reproducible and the verified signature stays bound to the bytes that run",
            "remarks": "rule_set_02"
          }
        ],
        "control-implementations": [
          {
            "uuid": "da97169b-79e1-4ae0-943a-6ae21cb821f7",
            "source": "profiles/nist_800_53/profile.json",
            "description": "NIST SP 800-53 rev 5 HIGH baseline (KubeCon three-tier demo subset)",
            "set-parameters": [
              {
