              {
                "param-id": "approved_signer_oidc_issuer",
                "values": [
                  "https://token.actions.githubusercontent.com"
                ]
              },
              {
                "param-id": "approved_registry_ledger_namespace",
                "values": [
                  "supply-chain"
                ]
              }
            ],
