          }
        ]
      },
      {
        "uuid": "3bc18953-5880-4a81-b3ca-fb0e7d73c203",
        "type": "service",
        "title": "three-tier-app",
        "description": "Hand-rolled three-tier storefront on vanilla Kubernetes: web tier / api tier / db tier in namespace storefront",
        "props": [
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "container-runs-unprivileged",
            "remarks": "rule_set_03"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "No storefront container runs privileged or may escalate privileges; all Linux capabilities are dropped; runAsNonRoot is set; host namespaces and hostPath volumes are not used so that every workload keeps a separate execution domain",
            "remarks": "rule_set_03"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "workload-inventory-labelled",
            "remarks": "rule_set_04"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "Every storefront workload carries the inventory labels that make it attributable in the system component inventory: application name / part-of / data classification / owning team",
            "remarks": "rule_set_04"
          },
          {
            "name": "Parameter_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "required_workload_labels",
            "remarks": "rule_set_04"
          },
          {
            "name": "Parameter_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "Label keys every storefront workload must carry (blank separated). Rendered into a CEL list literal in all three engines",
            "remarks": "rule_set_04"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "db-credentials-from-secret",
            "remarks": "rule_set_05"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "Database credentials reach the db and api tiers only through secretKeyRef; no credential environment variable may carry a literal value in the workload manifest where it would be exposed in etcd / kubectl output / Git / audit records",
            "remarks": "rule_set_05"
          },
          {
            "name": "Parameter_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "credential_env_keys",
            "remarks": "rule_set_05"
          },
          {
            "name": "Parameter_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "Environment variable names that must be sourced from a Secret rather than a literal value (blank separated)",
            "remarks": "rule_set_05"
          }
        ],
        "control-implementations": [
          {
            "uuid": "b358d903-7523-4eb4-b7e3-636e715fcb63",
            "source": "profiles/nist_800_53/profile.json",
