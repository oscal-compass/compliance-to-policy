# Generated by C2P ({{ engine }}) — rule {{ rule.id }} / check {{ check.id }}
# {{ check.description }}
# The label keys below are rendered from the OSCAL parameter required_workload_labels.
# The two CEL engines render the same parameter as a CEL list literal; the Kyverno DSL
# renders it as a pattern. One authored value, three generated policies.
apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/rule-id: {{ rule.id }}
    compliance.oscal/check-id: {{ check.id }}
    compliance.oscal/control-ids: cm-8
  annotations:
    policies.kyverno.io/title: Storefront workloads carry inventory labels
    policies.kyverno.io/description: >-
      NIST SP 800-53 cm-8. Without these labels a running workload cannot be attributed to
      an owner or a data classification, so it cannot appear in the component inventory.
spec:
  validationFailureAction: Enforce
  background: true
  rules:
    - name: required-inventory-labels
      match:
        any:
          - resources:
              kinds: [Deployment, StatefulSet]
              namespaces: [storefront]
      validate:
        message: "NIST SP 800-53 cm-8: the workload and its pod template must carry all required inventory labels (check {{ check.id }})"
        pattern:
          metadata:
            labels:
{%- for k in params.required_workload_labels.split(' ') %}
              {{ k }}: "?*"
{%- endfor %}
          spec:
            template:
              metadata:
                labels:
{%- for k in params.required_workload_labels.split(' ') %}
                  {{ k }}: "?*"
{%- endfor %}
