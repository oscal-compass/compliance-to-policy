{%- set o = '{{' -%}
{%- set c = '}}' -%}
# Generated by C2P ({{ engine }}) — rule {{ rule.id }} / check {{ check.id }}
# {{ check.description }}
apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/rule-id: {{ rule.id }}
    compliance.oscal/check-id: {{ check.id }}
    compliance.oscal/control-ids: ia-5
  annotations:
    policies.kyverno.io/title: Database credentials come from a Secret
    policies.kyverno.io/description: >-
      NIST SP 800-53 ia-5. A literal credential in a workload manifest is disclosed in
      kubectl output, in etcd, in Git and in every audit record that carries the object.
spec:
  validationFailureAction: Enforce
  background: true
  rules:
    - name: credential-env-must-use-secretkeyref
      match:
        any:
          - resources:
              kinds: [Deployment, StatefulSet]
              namespaces: [storefront]
      validate:
        # The message cannot name {{ o }} element.name {{ c }}: Kyverno rejects the policy with
        # "variable 'element.name' present outside of foreach", because element only exists
        # inside the foreach below. Keep the message static and let the parameter name the keys.
        message: >-
          NIST SP 800-53 ia-5: a credential environment variable carries a literal value and must
          use valueFrom.secretKeyRef instead. Keys that must come from a Secret:
          {{ params.credential_env_keys }} (check {{ check.id }})
        foreach:
          - list: "request.object.spec.template.spec.containers[].env[]"
            deny:
              conditions:
                all:
                  - key: "{{ o }} element.name {{ c }}"
                    operator: AnyIn
                    value: {{ params.credential_env_keys.split(' ') | tojson }}
                  - key: "{{ o }} element.keys(@) {{ c }}"
                    operator: AnyIn
                    value: ["value"]
