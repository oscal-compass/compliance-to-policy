{%- set o = '{{' -%}
{%- set c = '}}' -%}
# Generated by C2P ({{ engine }}) — rule {{ rule.id }} / check {{ check.id }}
# {{ check.description | oneline }}
#
# No vap-cel counterpart exists for this rule: upstream ValidatingAdmissionPolicy cannot
# read another object. Its CEL has no resource library, and paramRef binds objects at bind
# time and evaluates them conjunctively, which is the wrong shape for a set-membership test.
#
# NOTE: context.apiCall is a LIST of the ledger ConfigMaps, not a GET of one named ConfigMap.
# A GET that 404s makes the rule error, and an errored check is not a passing one — so a
# missing ConfigMap would read as a control with a problem rather than as the configuration
# mistake it is. A list of zero items is an honest empty allow-list.
apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/rule-id: {{ rule.id }}
    compliance.oscal/check-id: {{ check.id }}
    compliance.oscal/control-ids: cm-7.5_cm-8.3
  annotations:
    policies.kyverno.io/title: Images come from a registry in the approved-registry ledger
    policies.kyverno.io/description: >-
      NIST SP 800-53 cm-7.5 Authorized Software — allow-by-exception, and cm-8.3. The
      authoritative allow-list is cluster state in namespace {{ params.approved_registry_ledger_namespace | oneline }},
      so it changes without redeploying policy. Reading it is what VAP cannot do.
spec:
  validationFailureAction: Enforce
  background: true
  rules:
    - name: registry-must-be-in-ledger
      match:
        any:
          - resources:
              kinds: [Deployment, StatefulSet]
              namespaces: [storefront]
      context:
        - name: approvedRegistries
          apiCall:
            urlPath: {{ ('/api/v1/namespaces/' ~ params.approved_registry_ledger_namespace ~ '/configmaps') | quote }}
            jmesPath: "items[?metadata.labels.\"supply-chain.example.com/ledger\"=='approved-registry'].data.registry"
      validate:
        message: >-
          NIST SP 800-53 cm-7.5 cm-8.3: image registry {{ o }} split(element.image, '/') | [0] {{ c }}
          is not in the approved-registry ledger {{ o }} approvedRegistries {{ c }} (check {{ check.id }})
        foreach:
          - list: "request.object.spec.template.spec.containers[]"
            deny:
              conditions:
                all:
                  - key: "{{ o }} split(element.image, '/') | [0] {{ c }}"
                    operator: AnyNotIn
                    value: "{{ o }} approvedRegistries {{ c }}"
