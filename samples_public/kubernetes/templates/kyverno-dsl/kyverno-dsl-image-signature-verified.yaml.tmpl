# Generated by C2P ({{ engine }}) — rule {{ rule.id }} / check {{ check.id }}
# {{ check.description | oneline }}
#
# No vap-cel counterpart exists for this rule: verifying a signature needs a registry fetch
# and a Rekor transparency log round-trip, and CEL inside the API server has no I/O.
#
# Two attestor entries with count: 1, so either satisfies the control:
#   keyless  the release workflow's OIDC identity — how images published from CI are signed
#   keys     an organization-held public key in a Secret — how images signed off-line are
#            verified, which is also the only path that works without reaching Fulcio
# A real estate mid-migration accepts both, and si-7.15 ("cryptographic mechanisms to
# authenticate software ... prior to installation") covers either mechanism.
apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/rule-id: {{ rule.id }}
    compliance.oscal/check-id: {{ check.id }}
    compliance.oscal/control-ids: si-7.15_si-7
  annotations:
    policies.kyverno.io/title: Storefront images carry an approved cosign signature
    policies.kyverno.io/description: >-
      NIST SP 800-53 si-7.15 Code Authentication. cm-14 Signed Components is the control a
      reader expects here, but it is selected by no 800-53 rev 5 baseline, so si-7.15 carries
      the mapping.
spec:
  validationFailureAction: Enforce
  background: true
  webhookTimeoutSeconds: 30
  rules:
    - name: verify-storefront-image-signature
      match:
        any:
          - resources:
              kinds: [Pod]
              namespaces: [storefront]
      verifyImages:
        - imageReferences:
            - "ghcr.io/kubecon-demo/*"
            - "kind-registry:5000/kubecon-demo/*"
          failureAction: Enforce
          required: true
          verifyDigest: true
          attestors:
            - count: 1
              entries:
                # Both halves are OSCAL parameters: approved_signer_identity and
                # approved_signer_oidc_issuer. A subject only means anything against the issuer
                # that vouched for it, so neither belongs in the template.
                - keyless:
                    subject: {{ params.approved_signer_identity | quote }}
                    issuer: {{ params.approved_signer_oidc_issuer | quote }}
                    rekor:
                      url: https://rekor.sigstore.dev
                # The off-line trust root. Held as a constant: this names where the
                # organisation keeps its own key, which is a property of the cluster rather
                # than a compliance decision the profile should carry.
                - keys:
                    secret:
                      name: storefront-cosign-approved
                      namespace: supply-chain
                    rekor:
                      ignoreTlog: true
