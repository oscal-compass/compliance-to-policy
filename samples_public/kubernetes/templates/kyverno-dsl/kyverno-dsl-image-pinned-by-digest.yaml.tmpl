# Generated by C2P ({{ engine }}) — rule {{ rule.id }} / check {{ check.id }}
# {{ check.description }}
apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/rule-id: {{ rule.id }}
    compliance.oscal/check-id: {{ check.id }}
    compliance.oscal/control-ids: cm-2_si-7
  annotations:
    policies.kyverno.io/title: Container images must be pinned by digest
    policies.kyverno.io/description: >-
      NIST SP 800-53 cm-2 si-7. A mutable tag means the recorded baseline and the running
      bytes are not the same thing, and a signed tag can be re-pointed after verification.
spec:
  validationFailureAction: Enforce
  background: true
  rules:
    - name: image-must-carry-a-digest
      match:
        any:
          - resources:
              kinds: [Deployment, StatefulSet]
              namespaces: [storefront]
      validate:
        message: "NIST SP 800-53 cm-2 si-7: container images must be pinned by digest, not by a mutable tag (check {{ check.id }})"
        pattern:
          spec:
            template:
              spec:
                containers:
                  - image: "*@sha256:*"
