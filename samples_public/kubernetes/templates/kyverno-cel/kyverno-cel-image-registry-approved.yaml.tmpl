# Generated by C2P ({{ engine }}) — rule {{ rule.id }} / check {{ check.id }}
# {{ check.description | oneline }}
#
# This is one of the two checks that has no vap-cel counterpart. Upstream
# ValidatingAdmissionPolicy cannot read another object: its CEL has no resource
# library, and paramRef binds objects at bind time and evaluates them
# conjunctively, which is the wrong shape for a set-membership test.
#
# resource.List is verified against Kyverno 1.19.2. Its result is typed `any`, which CEL
# refuses to iterate ("expression of type 'any' cannot be range of a comprehension"), so the
# item list is wrapped in dyn() before any comprehension runs over it.
apiVersion: policies.kyverno.io/v1
kind: ValidatingPolicy
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/rule-id: {{ rule.id }}
    compliance.oscal/check-id: {{ check.id }}
    compliance.oscal/control-ids: cm-7.5_cm-8.3
spec:
  validationActions: [Deny, Audit]
  evaluation:
    background:
      enabled: true
  matchConstraints:
    namespaceSelector:
      matchLabels:
        kubernetes.io/metadata.name: storefront
    resourceRules:
      - apiGroups: ["apps"]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["deployments", "statefulsets"]
  variables:
    - name: ledger
      expression: {{ ('resource.List("v1", "configmaps", ' ~ (params.approved_registry_ledger_namespace | tojson) ~ ')') | quote }}
    - name: approved
      expression: >-
        dyn(variables.ledger.items)
          .filter(cm, has(cm.metadata.labels) &&
                      "supply-chain.example.com/ledger" in cm.metadata.labels &&
                      cm.metadata.labels["supply-chain.example.com/ledger"] == "approved-registry")
          .map(cm, cm.data["registry"])
    - name: containers
      expression: >-
        object.spec.template.spec.containers +
        (has(object.spec.template.spec.initContainers) ? object.spec.template.spec.initContainers : [])
    - name: unapproved
      expression: >-
        variables.containers.filter(c, !(c.image.split("/")[0] in variables.approved))
  validations:
    - expression: "size(variables.unapproved) == 0"
      messageExpression: >-
        'NIST SP 800-53 cm-7.5 cm-8.3: the image registry is not in the approved-registry ledger in namespace ' + {{ params.approved_registry_ledger_namespace | tojson }} + '. Offending: ' +
        variables.unapproved.map(c, c.image).join(', ') + ' (check {{ check.id }})'
