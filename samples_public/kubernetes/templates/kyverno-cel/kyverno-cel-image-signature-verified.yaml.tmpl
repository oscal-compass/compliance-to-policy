# Generated by C2P ({{ engine }}) — rule {{ rule.id }} / check {{ check.id }}
# {{ check.description | oneline }}
#
# This is the other check with no vap-cel counterpart, and the more absolute of the two:
# verifying a signature needs a registry fetch and a Rekor transparency log round-trip. CEL
# inside the API server has no I/O at any Kubernetes version, so there is no workaround
# rather than merely no convenient one.
#
# Two named attestors, either of which satisfies the control (the validation below counts
# matches and requires at least one):
#   release  the release workflow's OIDC identity — how images published from CI are signed
#   offline  an organization-held public key, read out of cluster state with resource.Get.
#            ImageValidatingPolicy has no secretRef for a key, but cosign.key.expression is
#            "a CEL expression that returns the public key", so the trust root can live in a
#            ConfigMap instead of being baked into the policy. That is a second thing upstream
#            ValidatingAdmissionPolicy could not do even if it could verify signatures.
apiVersion: policies.kyverno.io/v1
kind: ImageValidatingPolicy
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/rule-id: {{ rule.id }}
    compliance.oscal/check-id: {{ check.id }}
    compliance.oscal/control-ids: si-7.15_si-7
spec:
  validationActions: [Deny, Audit]
  evaluation:
    background:
      enabled: true
  webhookConfiguration:
    timeoutSeconds: 30
  matchConstraints:
    namespaceSelector:
      matchLabels:
        kubernetes.io/metadata.name: storefront
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["pods"]
  matchImageReferences:
    - glob: "ghcr.io/kubecon-demo/*"
    - glob: "kind-registry:5000/kubecon-demo/*"
  attestors:
    - name: release
      cosign:
        keyless:
          identities:
            # Both halves come from OSCAL parameters: approved_signer_identity and
            # approved_signer_oidc_issuer. A subject only means anything against the issuer
            # that vouched for it, so neither belongs in the template.
            - subject: {{ params.approved_signer_identity | quote }}
              issuer: {{ params.approved_signer_oidc_issuer | quote }}
        ctlog:
          url: "https://rekor.sigstore.dev"
    - name: offline
      cosign:
        key:
          expression: >-
            resource.Get("v1", "configmaps", "supply-chain", "storefront-cosign-approved").data["cosign.pub"]
        ctlog:
          insecureIgnoreTlog: true
          insecureIgnoreSCT: true
  validations:
    - expression: >-
        images.containers.map(image, verifyImageSignatures(image, [attestors.release, attestors.offline])).all(e, e > 0)
      message: "NIST SP 800-53 si-7.15 si-7: every image must carry a cosign signature from the approved release identity or the organization's approved key (check {{ check.id }})"
