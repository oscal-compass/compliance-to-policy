# Generated by C2P ({{ engine }}) — rule {{ rule.id }} / check {{ check.id }}
# {{ check.description }}
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/rule-id: {{ rule.id }}
    compliance.oscal/check-id: {{ check.id }}
    compliance.oscal/control-ids: ia-5
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: ["apps"]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["deployments", "statefulsets"]
  variables:
    - name: credentialKeys
      expression: '{{ params.credential_env_keys.split(' ') | tojson }}'
    - name: containers
      expression: >-
        object.spec.template.spec.containers +
        (has(object.spec.template.spec.initContainers) ? object.spec.template.spec.initContainers : [])
    # Deliberately no flatten(): the CEL available to ValidatingAdmissionPolicy has no such
    # function, so the check is phrased as "any container that has an offending env entry"
    # rather than "flatten every env list and filter it". Kyverno's CEL does have flatten,
    # but both engines run the same expression here on purpose.
    - name: offenders
      expression: >-
        variables.containers.filter(c,
          has(c.env) && c.env.exists(e, e.name in variables.credentialKeys && has(e.value)))
  validations:
    - expression: "size(variables.offenders) == 0"
      messageExpression: >-
        'NIST SP 800-53 ia-5: credential environment variables must come from a Secret via valueFrom.secretKeyRef, not a literal value. Offending containers: ' +
        variables.offenders.map(c, c.name).join(', ') + ' (check {{ check.id }})'
      reason: Invalid
  auditAnnotations:
    - key: compliance-check
      valueExpression: "'{{ check.id }}'"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/rule-id: {{ rule.id }}
    compliance.oscal/check-id: {{ check.id }}
spec:
  policyName: {{ check.id }}
  validationActions: [Deny, Audit]
  matchResources:
    namespaceSelector:
      matchLabels:
        kubernetes.io/metadata.name: storefront
