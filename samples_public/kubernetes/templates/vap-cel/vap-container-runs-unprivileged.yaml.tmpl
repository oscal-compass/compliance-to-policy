# Generated by C2P ({{ engine }}) — rule {{ rule.id }} / check {{ check.id }}
# {{ check.description }}
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/rule-id: {{ rule.id }}
    compliance.oscal/check-id: {{ check.id }}
    compliance.oscal/control-ids: ac-6_sc-39
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: ["apps"]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["deployments", "statefulsets"]
  variables:
    - name: pod
      expression: "object.spec.template.spec"
    - name: containers
      expression: >-
        variables.pod.containers +
        (has(variables.pod.initContainers) ? variables.pod.initContainers : [])
  validations:
    - expression: >-
        variables.containers.all(c,
          !has(c.securityContext) || !has(c.securityContext.privileged) || c.securityContext.privileged == false)
      message: "NIST SP 800-53 ac-6 sc-39: no container may run privileged (check {{ check.id }})"
      reason: Invalid
    - expression: >-
        variables.containers.all(c,
          has(c.securityContext) && has(c.securityContext.allowPrivilegeEscalation) &&
          c.securityContext.allowPrivilegeEscalation == false)
      message: "NIST SP 800-53 ac-6: allowPrivilegeEscalation must be set to false on every container (check {{ check.id }})"
      reason: Invalid
    - expression: >-
        (has(variables.pod.securityContext) && has(variables.pod.securityContext.runAsNonRoot) &&
         variables.pod.securityContext.runAsNonRoot == true) ||
        variables.containers.all(c,
          has(c.securityContext) && has(c.securityContext.runAsNonRoot) && c.securityContext.runAsNonRoot == true)
      message: "NIST SP 800-53 ac-6: runAsNonRoot must be true on the pod or on every container (check {{ check.id }})"
      reason: Invalid
    - expression: >-
        variables.containers.all(c,
          has(c.securityContext) && has(c.securityContext.capabilities) &&
          has(c.securityContext.capabilities.drop) && c.securityContext.capabilities.drop.exists(d, d == 'ALL'))
      message: "NIST SP 800-53 ac-6: every container must drop ALL capabilities (check {{ check.id }})"
      reason: Invalid
    - expression: >-
        (!has(variables.pod.hostPID) || variables.pod.hostPID == false) &&
        (!has(variables.pod.hostIPC) || variables.pod.hostIPC == false) &&
        (!has(variables.pod.hostNetwork) || variables.pod.hostNetwork == false)
      message: "NIST SP 800-53 sc-39: host PID, IPC and network namespaces must not be shared (check {{ check.id }})"
      reason: Invalid
    - expression: >-
        !has(variables.pod.volumes) || variables.pod.volumes.all(v, !has(v.hostPath))
      message: "NIST SP 800-53 sc-39: hostPath volumes are not permitted (check {{ check.id }})"
      reason: Invalid
  auditAnnotations:
    - key: compliance-check
      valueExpression: "'{{ check.id }}'"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/rule-id: {{ rule.id }}
    compliance.oscal/check-id: {{ check.id }}
spec:
  policyName: {{ check.id }}
  validationActions: [Deny, Audit]
  matchResources:
    namespaceSelector:
      matchLabels:
        kubernetes.io/metadata.name: storefront
