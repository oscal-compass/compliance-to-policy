# Generated by C2P ({{ engine }}) — rule {{ rule.id }} / check {{ check.id }}
# {{ check.description }}
# The "required" expression below is rendered from the OSCAL parameter
# required_workload_labels and is byte-identical to the one in the kyverno-cel output.
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/rule-id: {{ rule.id }}
    compliance.oscal/check-id: {{ check.id }}
    compliance.oscal/control-ids: cm-8
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: ["apps"]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["deployments", "statefulsets"]
  variables:
    - name: required
      expression: '{{ params.required_workload_labels.split(' ') | tojson }}'
    - name: labels
      expression: "has(object.metadata.labels) ? object.metadata.labels : {}"
    - name: podLabels
      expression: >-
        has(object.spec.template.metadata) && has(object.spec.template.metadata.labels)
        ? object.spec.template.metadata.labels : {}
  validations:
    - expression: "variables.required.all(k, k in variables.labels && size(variables.labels[k]) > 0)"
      messageExpression: >-
        'NIST SP 800-53 cm-8: the workload is missing required inventory labels: ' +
        variables.required.filter(k, !(k in variables.labels)).join(', ') + ' (check {{ check.id }})'
      reason: Invalid
    - expression: "variables.required.all(k, k in variables.podLabels && size(variables.podLabels[k]) > 0)"
      messageExpression: >-
        'NIST SP 800-53 cm-8: the pod template is missing required inventory labels: ' +
        variables.required.filter(k, !(k in variables.podLabels)).join(', ') + ' (check {{ check.id }})'
      reason: Invalid
  auditAnnotations:
    - key: compliance-check
      valueExpression: "'{{ check.id }}'"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/rule-id: {{ rule.id }}
    compliance.oscal/check-id: {{ check.id }}
spec:
  policyName: {{ check.id }}
  validationActions: [Deny, Audit]
  matchResources:
    namespaceSelector:
      matchLabels:
        kubernetes.io/metadata.name: storefront
