      {
        "uuid": "29643aa2-dad8-4576-b073-6079982b340a",
        "type": "validation",
        "title": "kyverno-dsl",
        "description": "Kyverno ClusterPolicy (kyverno.io/v1): admission enforcement plus background scan. Kyverno's earlier policy API and the one most estates are running today",
        "props": [
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "image-signature-verified",
            "remarks": "rule_set_06"
          },
          {
            "name": "Check_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "kyverno-dsl-image-signature-verified",
            "remarks": "rule_set_06"
          },
          {
            "name": "Check_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "TEST: ClusterPolicy verifyImages rule over every container image of the storefront workloads in ghcr.io/kubecon-demo/* and kind-registry:5000/kubecon-demo/* with two attestors of which either satisfies the rule: a keyless cosign attestor (subject = approved_signer_identity; issuer = approved_signer_oidc_issuer; Rekor) and the organization's own public key published as the cosign.pub entry of ConfigMap storefront-cosign-approved in namespace supply-chain (signed offline so there is no transparency log entry to check)",
            "remarks": "rule_set_06"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "image-registry-approved",
            "remarks": "rule_set_07"
          },
          {
            "name": "Check_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "kyverno-dsl-image-registry-approved",
            "remarks": "rule_set_07"
          },
          {
            "name": "Check_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "TEST: ClusterPolicy context.apiCall lists ConfigMaps labelled supply-chain.example.com/ledger=approved-registry in approved_registry_ledger_namespace and denies any image whose registry host is absent from the ledger",
            "remarks": "rule_set_07"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "image-pinned-by-digest",
            "remarks": "rule_set_08"
          },
          {
            "name": "Check_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "kyverno-dsl-image-pinned-by-digest",
            "remarks": "rule_set_08"
          },
          {
            "name": "Check_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "TEST: ClusterPolicy denies any container image reference that is not of the form repository@sha256:digest",
            "remarks": "rule_set_08"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "container-runs-unprivileged",
            "remarks": "rule_set_09"
          },
          {
            "name": "Check_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "kyverno-dsl-container-runs-unprivileged",
            "remarks": "rule_set_09"
          },
          {
            "name": "Check_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "TEST: ClusterPolicy denies privileged containers allowPrivilegeEscalation host namespaces hostPath volumes and any container that does not drop ALL capabilities",
            "remarks": "rule_set_09"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "workload-inventory-labelled",
            "remarks": "rule_set_10"
          },
          {
            "name": "Check_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "kyverno-dsl-workload-inventory-labelled",
            "remarks": "rule_set_10"
          },
          {
            "name": "Check_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "TEST: ClusterPolicy requires every label key in required_workload_labels to be present and non-empty on the workload and on its pod template",
            "remarks": "rule_set_10"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "db-credentials-from-secret",
            "remarks": "rule_set_11"
          },
          {
            "name": "Check_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "kyverno-dsl-db-credentials-from-secret",
            "remarks": "rule_set_11"
          },
          {
            "name": "Check_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "TEST: ClusterPolicy denies any env entry whose name is in credential_env_keys and that carries a literal value instead of valueFrom.secretKeyRef",
            "remarks": "rule_set_11"
          }
        ]
      },
      {
        "uuid": "6f36f7f5-18ee-40ca-ad48-3bd2f492e000",
        "type": "validation",
        "title": "kyverno-cel",
        "description": "Kyverno policy types (policies.kyverno.io/v1): ValidatingPolicy and ImageValidatingPolicy, written in CEL, with admission enforcement plus background scan",
        "props": [
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "image-signature-verified",
