          }
        ]
      },
      {
        "uuid": "ca5e06d4-9d20-4f23-8728-323dbaf7ed82",
        "type": "validation",
        "title": "vap-cel",
        "description": "Upstream Kubernetes admission CEL: admissionregistration.k8s.io/v1 ValidatingAdmissionPolicy with binding. Admission time only. No external data and no background scan",
        "props": [
          {
            "name": "Rule_Id",
