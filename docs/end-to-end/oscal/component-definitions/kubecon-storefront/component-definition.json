  "component-definition": {
    "uuid": "bd41b369-b757-4adb-a93b-a08f735d5d02",
    "metadata": {
      "title": "Three-tier storefront on vanilla Kubernetes — NIST SP 800-53 rev 5 demo",
      "last-modified": "2026-11-09T10:21:33+00:00",
