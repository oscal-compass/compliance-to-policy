            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "kyverno-cel-image-registry-approved",
            "remarks": "rule_set_13"
          },
          {
            "name": "Check_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "TEST: ValidatingPolicy variable lists ConfigMaps in approved_registry_ledger_namespace and requires every image registry host to appear in the ledger",
