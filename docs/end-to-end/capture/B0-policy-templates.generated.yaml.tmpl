# Generated by C2P ({{ engine }}) — rule {{ rule.id }} / check {{ check.id }}
# {{ check.description }}
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/engine: {{ engine }}
    compliance.oscal/rule-id: {{ rule.id }}
    compliance.oscal/check-id: {{ check.id }}
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["pods"]
      - apiGroups: ["apps"]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["deployments", "statefulsets", "daemonsets", "replicasets"]
      - apiGroups: ["batch"]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["jobs", "cronjobs"]
  variables:
    # The pod spec, wherever the matched kind keeps it: a CronJob nests it twice,
    # the apps/v1 controllers and Job once, a bare Pod not at all.
    - name: podSpec
      expression: >-
        has(object.spec.jobTemplate)
        ? object.spec.jobTemplate.spec.template.spec
        : (has(object.spec.template) ? object.spec.template.spec : object.spec)
    # initContainers run the same images and are as much of the baseline as the
    # app containers. ephemeralContainers cannot be set on create and arrive
    # through a subresource this policy does not match.
    - name: allContainers
      expression: >-
        variables.podSpec.containers +
        (has(variables.podSpec.initContainers) ? variables.podSpec.initContainers : [])
    - name: unpinned
      expression: 'variables.allContainers.filter(c, !c.image.contains("@sha256:"))'
  validations:
    - expression: 'variables.unpinned.size() == 0'
      messageExpression: >-
        "every container image must be referenced as repository@sha256:<digest>, not by a
        mutable tag; not pinned: " +
        variables.unpinned.map(c, c.name + "=" + c.image).join(", ")
      reason: Invalid
  auditAnnotations:
    # Stamped so a dry-run probe result can be attributed to this check: the
    # engine writes no report of its own.
    - key: check-id
      valueExpression: '{{ check.id | quote }}'
    - key: unpinned-images
      valueExpression: 'variables.unpinned.map(c, c.name + "=" + c.image).join(",")'
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: {{ check.id }}
  labels:
    compliance.oscal/engine: {{ engine }}
    compliance.oscal/rule-id: {{ rule.id }}
    compliance.oscal/check-id: {{ check.id }}
spec:
  policyName: {{ check.id }}
  validationActions: ["Deny", "Audit"]
  matchResources:
    # REVIEW: the enforcement scope is the one value here that the render context
    # does not carry — the component definition states the storefront namespace in
    # prose only. See the note in the generation report.
    namespaceSelector:
      matchLabels:
        kubernetes.io/metadata.name: storefront
